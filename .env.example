# Copie este arquivo para .env e ajuste os valores.
# Localmente, se você não criar o .env, o sistema usa SQLite e DEBUG=True.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# No Railway, a variável DATABASE_URL é criada automaticamente
# quando você adiciona um serviço PostgreSQL ao projeto.
